# ============================================================
# 合成星核 H5 — 服务器环境变量模板
# 复制为 .env 后按需填写；.env 已被 git 忽略，切勿提交真实密钥
# ============================================================

# ---- 基础 ----
# 服务监听端口
PORT=3000
# 生产环境必须设为 production（关闭开发模式与模拟支付接口）
NODE_ENV=production
# 允许跨域访问 API 的 H5 来源，多个用逗号分隔（与 H5 页面部署域名一致）
H5_ORIGIN=http://localhost:8080
# SQLite 数据库文件路径（默认 server/data/starcore.db）
# DB_PATH=

# ---- 微信支付 H5（未接入可留空）----
WX_MCH_ID=
WX_APP_ID=
WX_API_V3_KEY=
WX_MCH_SERIAL_NO=
# 商户私钥文件路径（默认 server/certs/wx_mch_private_key.pem）
# WX_MCH_PRIVATE_KEY_PATH=
# 支付结果回调地址，需外网可访问，如 https://api.example.com/api/notify/wechat
WX_NOTIFY_URL=

# ---- 支付宝 H5（未接入可留空）----
ALIPAY_APP_ID=
# 应用私钥（单行 base64 或 PEM 格式）
ALIPAY_APP_PRIVATE_KEY=
# 支付宝公钥（单行 base64 或 PEM 格式，注意不是应用公钥）
ALIPAY_PUBLIC_KEY=
# 异步通知地址，需外网可访问，如 https://api.example.com/api/notify/alipay
ALIPAY_NOTIFY_URL=
# 默认 https://openapi.alipay.com/gateway.do
# ALIPAY_GATEWAY=

# ---- 安全 ----
# JWT 签名密钥（生产环境必须更换）
JWT_SECRET=
# 支付签名密钥（生产环境必须更换）
PAY_SIGN_KEY=
